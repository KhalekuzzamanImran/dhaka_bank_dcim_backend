DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=change-this-secret-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,10.156.0.250
DATABASE_URL=postgresql://dcim:dcim@pgbouncer:6432/dcim
DB_CONN_MAX_AGE=0
DISABLE_SERVER_SIDE_CURSORS=true
POSTGRES_DB=dcim
POSTGRES_USER=dcim
POSTGRES_PASSWORD=dcim
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=300
PGBOUNCER_DEFAULT_POOL_SIZE=20
PGBOUNCER_MIN_POOL_SIZE=5
PGBOUNCER_RESERVE_POOL_SIZE=5
API_WORKERS=3
REPORT_ARTIFACT_RETENTION_DAYS=365
RETENTION_CLEANUP_ENABLED=true
RETENTION_CLEANUP_DRY_RUN=false
RETENTION_CLEANUP_BATCH_SIZE=500
RETENTION_INGEST_LOG_DAYS=90
RETENTION_DEVICE_EVENT_DAYS=365
RETENTION_SNMP_TRAP_EVENT_DAYS=365
RETENTION_ALERT_EVENT_DAYS=365
RETENTION_ALERT_HISTORY_DAYS=365
RETENTION_NOTIFICATION_DAYS=365
RETENTION_NOTIFICATION_DELIVERY_DAYS=180
RETENTION_AUDIT_LOG_DAYS=365
RETENTION_REPORT_METADATA_DAYS=365
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
REDIS_CACHE_URL=redis://redis:6379/2
REDIS_CHANNEL_LAYER_URL=redis://redis:6379/3
CORS_ALLOWED_ORIGINS=http://172.25.204.238:3000,http://10.156.0.250:3000,http://localhost:3000,http://localhost:4173,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:4173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://172.25.204.238:3000,http://10.156.0.250:3000,http://localhost:3000,http://localhost:4173,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:4173,http://127.0.0.1:5173
FRONTEND_ORIGIN=http://10.156.0.250:3000
LOG_LEVEL=INFO

# Opt-in database diagnostics. EXPLAIN ANALYZE executes slow SELECTs twice,
# so enable it only during controlled performance investigations.
QUERY_MONITORING_ENABLED=false
QUERY_MONITORING_SLOW_MS=100
QUERY_MONITORING_EXPLAIN_ENABLED=false
QUERY_MONITORING_EXPLAIN_SLOW_MS=250
QUERY_MONITORING_EXPLAIN_PATHS=/api/v1/devices/devices/
QUERY_MONITORING_MAX_SQL_LENGTH=4000

# Email notification
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=dcim-alerts@mail.local

# If you need console delivery for isolated local runs, switch back to:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# SMS notification
SMS_BACKEND=console
SMS_API_URL=
SMS_API_KEY=
SMS_DEFAULT_SENDER=DCIM
SMS_TIMEOUT_SECONDS=15

# Future SMS production example
# SMS_BACKEND=http
# SMS_API_URL=https://sms-gateway.example.com/send
# SMS_API_KEY=change-me
# SMS_DEFAULT_SENDER=DCIM

# Keep this stable in production; changing it makes encrypted SNMP secrets unreadable.
FIELD_ENCRYPTION_KEY=change-me-long-random-field-encryption-key
SNMP_CELERY_QUEUE=snmp
SNMP_ENQUEUE_INTERVAL_SECONDS=30
SNMP_ENQUEUE_LIMIT=200

# Polling and trap receiver
POLLING_SCHEDULER_INTERVAL_SECONDS=5
POLLING_SCHEDULER_LIMIT=200
SNMP_CELERY_QUEUE=snmp_normal
MODBUS_CELERY_QUEUE=modbus_normal
SNMP_TRAP_LISTEN_HOST=0.0.0.0
SNMP_TRAP_LISTEN_PORT=1162
FIELD_ENCRYPTION_KEY=change-this-to-a-long-stable-secret-before-production
